# Private Internet Access Creds
# ==========================================
PIA_USERNAME=
PIA_PASSWORD=

# VPN connection type (wireguard or openvpn - wireguard is recommended for performance)
VPN_TYPE=wireguard

# PIA Region to connect to (e.g., Netherlands, US East, CA Toronto)
# Leave blank to connect to the fastest available
PIA_REGION=

# System Configuration
# ==========================================
# User and Group ID for file permissions
# Use `id -u` and `id -g` in your terminal to find yours
PUID=1000
PGID=1000

# Timezone (e.g., America/New_York, Europe/London)
TZ=America/New_York

# Directory Configuration
# ==========================================
# Host path where downloads will be saved
DOWNLOAD_DIR=./downloads
